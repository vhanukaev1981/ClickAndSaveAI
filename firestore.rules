rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production data is backend-owned. Cloud Functions use Admin SDK and bypass rules.
    // No Android client receives direct access to OAuth credentials, import audit data,
    // CRM lead records, or any future user subtree until an explicit schema is reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
