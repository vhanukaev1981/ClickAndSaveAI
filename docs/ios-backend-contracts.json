              "recurringServiceCount",
              "recurringServices",
              "categories"
            ],
            "properties": {
              "sourceCoverage": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isCompleteHouseholdSpend": {
                "type": "boolean"
              },
              "observedRecurringMonthlySpend": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "recurringServiceCount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "recurringServices": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "insights": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "opportunities": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "errorCodes": [
        "unauthenticated",
        "permission-denied",
        "internal"
      ],
      "status": "NOT_STARTED",
      "clientImplementation": {
        "androidFile": "app/src/main/java/com/example/data/repository/FinancialHomeRepository.kt",
        "iosTargetFile": "ClickAndSaveAI/Data/Repositories/FinancialHomeRepository.swift"
      }
