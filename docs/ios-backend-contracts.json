{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Click & Save AI iOS Backend Contract Specification and Parity Manifest",
  "backendRegion": "europe-west1",
  "canonicalBackendUrlPattern": "https://europe-west1-click-save-ai-production.cloudfunctions.net/{endpointName}",
  "endpoints": [
    {
      "name": "getFinancialHome",
      "type": "callable",
      "region": "europe-west1",
      "authRequired": true,
      "appCheckEnforced": true,
      "activeAccountRequired": true,
      "requestSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "responseSchema": {
        "type": "object",
        "required": [
          "currentMonthTotal",
          "previousMonthTotal",
          "potentialMonthlySavings",
          "potentialAnnualSavings",
          "activeOpportunitiesCount",
          "topOpportunities",
          "monthlyTrend",
          "lastUpdated"
        ],
        "properties": {
          "currentMonthTotal": { "type": "number" },
          "previousMonthTotal": { "type": "number" },
          "potentialMonthlySavings": { "type": "number" },
          "potentialAnnualSavings": { "type": "number" },
          "activeOpportunitiesCount": { "type": "integer" },
          "topOpportunities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "providerName", "category", "currentMonthlyCost", "potentialMonthlySaving"],
              "properties": {
                "id": { "type": "string" },
                "providerName": { "type": "string" },
                "category": { "type": "string" },
                "currentMonthlyCost": { "type": "number" },
                "potentialMonthlySaving": { "type": "number" },
                "potentialAnnualSaving": { "type": "number" },
                "matchedOffer": { "type": "object" },
                "status": { "type": "string" }
              }
            }
          },
          "monthlyTrend": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "month": { "type": "string" },
                "totalAmount": { "type": "number" }
              }
            }
          },
          "lastUpdated": { "type": "string" }
        }
      },
      "errorCodes": ["unauthenticated", "permission-denied", "internal"],
      "status": "NOT_STARTED",
      "clientImplementation": {
        "androidFile": "app/src/main/java/com/example/data/repository/FinancialHomeRepository.kt",
        "iosTargetFile": "ClickAndSaveAI/Data/Repositories/FinancialHomeRepository.swift"
      }
    },
    {
      "name": "getFinancialActivity",
      "type": "callable",
      "region": "europe-west1",
      "authRequired": true,
      "appCheckEnforced": true,
      "activeAccountRequired": true,
      "requestSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "responseSchema": {
        "type": "object",
        "required": ["ledger", "count"],
        "properties": {
          "ledger": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["eventId", "type", "timestamp"],
              "properties": {
                "eventId": { "type": "string" },
                "type": { "type": "string" },
                "timestamp": { "type": "string" },
                "title": { "type": "string" },
                "amount": { "type": "number" },
                "details": { "type": "object" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      },
      "errorCodes": ["unauthenticated", "permission-denied", "internal"],
      "status": "NOT_STARTED",
      "clientImplementation": {
        "androidFile": "app/src/main/java/com/example/data/repository/FinancialHomeRepository.kt",
        "iosTargetFile": "ClickAndSaveAI/Data/Repositories/FinancialHomeRepository.swift"
      }
    },
